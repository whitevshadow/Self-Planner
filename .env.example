# Copy to .env and fill in the gateway credentials:  cp .env.example .env
#
# Everything here is OPTIONAL for `docker compose up` to start — the compose
# file supplies working defaults for Postgres and MinIO. Without LLM_API_KEY
# the app boots and the UI works, but transcription, extraction, planning and
# chat all need a reachable OpenAI-compatible gateway.

# ── Infra ───────────────────────────────────────────────────────────────────
# DATABASE_URL / MINIO_ENDPOINT are overridden by docker-compose for the
# container network; these values are for running the backend on the host.
DATABASE_URL=postgresql+psycopg2://planner:planner@localhost:5432/self_planner
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=meetings-audio
MINIO_SECURE=false
MAX_UPLOAD_MB=200

# ── LLM / STT gateway (OpenAI-compatible, e.g. LiteLLM) ─────────────────────
# Host-process value. In Docker, compose rewrites this to GATEWAY_URL below.
LLM_BASE_URL=http://localhost:1050/v1
# Where the containerized backend reaches the gateway. Default:
# http://host.docker.internal:1050/v1 (gateway published on the Docker host).
# GATEWAY_URL=http://host.docker.internal:1050/v1
LLM_API_KEY=
LLM_TIMEOUT_SEC=300
LLM_REASONING_EFFORT=none

# Transcription via the gateway's /v1/audio/transcriptions.
ASR_MODEL=whisper-large-v3

# Per-job chat models (must exist on your gateway).
LLM_MODEL_SUMMARY=openai/gpt-oss-20b
LLM_MODEL_EXTRACT=openai/gpt-oss-20b
LLM_MODEL_CLASSIFY=openai/gpt-oss-20b
LLM_MODEL_TRIAGE=openai/gpt-oss-120b

# ── Speaker diarization (local pyannote, CPU) ───────────────────────────────
# Empty HF_TOKEN skips diarization; the UI then offers manual speaker labels.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# ── Frontend ────────────────────────────────────────────────────────────────
# Baked into the browser bundle at image build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
